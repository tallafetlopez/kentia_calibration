              {                                                                                                           
                uint;  /* RSTR_ID         unique id. Is referred to in the measurement sections       */                  
                uint;  /* RSTR_PRIO       event priority, higher number = higher priority             */                  
                ulong; /* RSTR_MIN_TIME   worst case minimum raster time in us, 0 is not considered in the raster check */
                taggedstruct {                                                                                            
                  (block "ETK_XETK_SPECIFIC" struct                                                                       
                  {                                                                                                       
                    taggedunion {            /* TRG_GEN raster trigger generation                     */                  
                      "TRG_NBR" struct                                                                                    
                      {                                                                                                   
                        uint;                /* hardware trigger number                               */                  
                      };                                                                                                  
                      "TIMER_REF" struct                                                                                  
                      {                                                                                                   
                        uint;                /* TIMER_REF         reference to TIMER_ID               */                  
                      };                                                                                                  
                      "TRACE_TRIGGER_REF" struct                                                                          
                      {                                                                                                   
                        uint;                /* TRACE_TRIGGER_REF reference to trace TRACE_TRIGGER_ID */                  
                      };                                                                                                  
                      "STIM_EVENT" struct                                                                                 
                      {                                                                                                   
                        uint;                /* STIM_EVENT the "event" for the stimulation action */                      
                      };                                                                                                  
                      "START_MEASUREMENT_EVENT" struct                                                                    
                      {                                                                                                   
                        uint;                /* the "event" generated at the start of the measurement */                  
                      };                                                                                                  
                                                                                                                          
                    };                                                                                                    
                    taggedunion {            /* TRG_TYPE          trigger type                   */                       
                      "DIRECT";                                                                                           
                      "INDIRECT" struct{                                                                                  
                        ulong;               /* TRG_FLG_ADDR      Flag for indirect trigger      */                       
                      };                                                                                                  
                    };                                                                                                    
                                                                                                                          
                    taggedstruct                                                                                          
                    { /* definition for Accumulation mode; */                                                             
                      block "ACCUMULATION_MODE" struct                                                                    
                      {                                                                                                   
                        uint;  /* SUB_SAMPLES no. of samples to be collected  */                                          
                               /* before trigger to ETK is generated          */                                          
                        taggedstruct                                                                                      
                        {                                                                                                 
                          /* Measurement Variable size restrictions.                        */                            
                          /* If missing ECU supports all  for accumulated measurement.      */                            
                          /* Can be used multiple times to exclude different variable sizes */                            
                          ("DATA_TYPE_RESTRICTION" enum                                                                   
                          {                                                                                               
                            "NO_BYTES"   = 1,  /* no byte values allowed   */                                             
                            "NO_2BYTES"  = 2,  /* no 2 byte values allowed */                                             
                            "NO_4BYTES"  = 3,  /* no 4 byte values allowed */                                             
                            "NO_8BYTES"  = 4   /* no 8 byte values allowed */                                             
                          })*;                                                                                            
                                                                                                                          
                          /* Method for alignment of sub sample entries */                                                
                          "SUB_SAMPLE_BUFFER_ALIGNMENT" enum                                                              
                          {                                                                                               
                            "_2BYTES" = 1,  /* 2 bytes */                                                                 
                            "_4BYTES" = 2,  /* 4 bytes */                                                                 
                            "_8BYTES" = 3   /* 8 bytes */                                                                 
                          };                                                                                              
                        };                                                                                                
                      };                                                                                                  
                    };                                                                                                    
                                                                                                                          
                    taggedstruct {                                                                                        
                      block "DISTAB_LAYOUT" struct {                                                                      
                        ulong;                   /* DSPL_ADDRTBL_ADDR address of display address     */                   
                                                 /*                   table                          */                   
                        uint;                    /* DSPL_ADDRTBL_MAX  maximum number of variables    */                   
                                                 /*                   in display address table       */                   
                        ulong;                   /* DSPL_OUTTBL_ADDR  address of display output      */                   
                                                 /*                   table                          */                   
                        uint;                    /* DSPL_OUTTBL_LEN   maximum size of display output */                   
                                                 /*                   table in bytes                 */                   
                      };                                                                                                  
                                                                                                                          
                      block "BYPASS_LAYOUT" struct {                                                                      
                        ulong;               /* BYPS_OUTTBL_ADDR  address of the bypass output   */                       
                                             /*                   table                          */                       
                        ulong;               /* BYPS_OUTTBL_LEN   maximum size of bypass output  */                       
                                             /*                   table in byte                  */                       
                      };                                                                                                  
                                                                                                                          
                      "ETK_XETK_REF" (ulong)*; /* references to used ETKs                        */                       
                                                                                                                          
                      /* special entries to make this raster usable for 3rd party tools:       */                         
                                                                                                                          
                      "RESERVED_RASTER_DISTAB_SETUP_XETK";  /* INCA configures the XETK raster */                         
                                                            /* for use with 3rd party tool     */                         
                                                            /* XETK sets up DISTAB             */                         
                      "RESERVED_RASTER_DISTAB_IGNORE_XETK"; /* INCA configures the XETK raster */                         
                                                            /* for use with 3rd party tool     */                         
                                                            /* XETK ignores DISTAB             */                         
                                                            /* (does not setup DISTAB)         */                         
                    };                                                                                                    
                                                                                                                          
                    taggedstruct {                                                                                        
                      block "ECU_PROPERTY" struct {                                                                       
                        taggedstruct {                                                                                    
                          "PERFORMANCE" struct                                                                            
                          {                                                                                               
                            ulong;     /* core                       */                                                   
                            ulong;     /* variables per second       */                                                   
                            ulong;     /* bytes per second           */                                                   
                          };                                                                                              
                          "NOT_ALLOWED_8_BITS";  /* 8 bit variables are not allowed               */                      
                          "NOT_ALLOWED_16_BITS"; /* 16 bit variables are not allowed              */                      
                          "NOT_ALLOWED_32_BITS"; /* 32 bit variables are not allowed              */                      
                          "NOT_ALLOWED_64_BITS"; /* 64 bit variables are not allowed              */                      
                        };                                                                                                
                      };                                                                                                  
                    };                                                                                                    
                  })*;                                                                                                    
                };                                                                                                        
              };                                                                                                          
            };                                                                                                            
          })*;                                                                                                            
        };                                                                                                                
      };                                                                                                                  
    };                                                                                                                    
    /end A2ML                                                                                                             
    /begin MOD_PAR
      ""

      /begin MEMORY_SEGMENT
        Strategy
        "Strategy/application code"
        CODE
        FLASH
        INTERN
        0x100000
        0x300000
        -1 -1 -1 -1 -1
        /begin IF_DATA ETK_XETK
          /begin ETK_XETK_ACCESS
            SERIAL_INTERFACE
            PHYSICAL_ADDRESS 0x100000
            ETK_XETK_REF 1
          /end ETK_XETK_ACCESS
        /end IF_DATA
      /end MEMORY_SEGMENT

      /begin MEMORY_SEGMENT
        Calibration
        "Calibration data"
        DATA
        FLASH
        INTERN
        0x80000
        0x20000
        -1 -1 -1 -1 -1
        /begin IF_DATA ETK_XETK
          /begin ETK_XETK_ACCESS
            SERIAL_INTERFACE
            PHYSICAL_ADDRESS 0x80000
            ETK_XETK_REF 1
          /end ETK_XETK_ACCESS
        /end IF_DATA
      /end MEMORY_SEGMENT

      /begin MEMORY_SEGMENT
        RAM
        ""
        VARIABLES
        RAM
        INTERN
        0x40000000
        0x20000
        -1 -1 -1 -1 -1
        /begin IF_DATA ETK_XETK
          /begin ETK_XETK_ACCESS
            SERIAL_INTERFACE
            PHYSICAL_ADDRESS 0x40000000
            ETK_XETK_REF 1
          /end ETK_XETK_ACCESS
        /end IF_DATA
      /end MEMORY_SEGMENT

    /end MOD_PAR

    /begin IF_DATA ETK_XETK
      /begin ETK_XETK_LIST
        ETK_XETK_AML_VERSION_2_0_0

        /begin XETK
          1
          CONFIG "BaseId" "4"           /* XETKV2 */
          CONFIG "Extension" "1"
          CONFIG "CpuType" "MPC5674F_Rev2"
          CONFIG "EcuVoltageLevel" "33"
          CONFIG "AutoPowerSaveEnabled" "1"
          CONFIG "ThresholdVoltageA" "2258"
          CONFIG "ThresholdVoltageB" "2258"
          CONFIG "HandshakeTimeout" "-1"
          CONFIG "TriggerInterface" "dai"
          CONFIG "JtagClockSpeed" "40"
          CONFIG "StandbyTimeout" "0"
          CONFIG "EcuChipSelect" "0"
          CONFIG "CalBusDataWidth" "32"
          CONFIG "ResetOut" "0"
          CONFIG "WpMemBaseAddress" "0x40020000"
          CONFIG "WpMemSize" "0x20000"
          CONFIG "MuxData31" "SCS2"
          CONFIG "MuxAddr11" "DAT11"
          CONFIG "ReadyPin"  "3"
        /end XETK

          /begin RASTER_CHECK
            OFFLINE_DEVICE 1
            ONLINE_RESPECT_OFFLINE_LIMIT
          /end RASTER_CHECK
        /end ETK_XETK_LIST

        /begin TP_BLOB
          BYTE_ORDER_MSB_FIRST
          /begin DISTAB_CFG
            13
          /end DISTAB_CFG
          /begin PAGE_SWITCH_METHOD
            0x1
            MAILBOX
            1
            100
            0x40003e9c
            AUTOSTART_BEHAVIOR ALWAYS_RP
            ETK_XETK_REF 1
          /end PAGE_SWITCH_METHOD
          /begin COLDSTART_HANDSHAKE
            0x40003e99
            WAIT 0xCC
            READY 0x33
            ETK_XETK_REF 1
          /end COLDSTART_HANDSHAKE
        /end TP_BLOB

        /begin SOURCE
            "task_10ms"
            0
            10000
            /begin QP_BLOB
                3
                3
                10000
                /begin ETK_XETK_SPECIFIC
                    TRG_NBR 15
                    INDIRECT 0x40003b88
                    /begin DISTAB_LAYOUT
                        0x40003b90
                        0x0
                        0x0
                        0x0
                    /end DISTAB_LAYOUT
                    ETK_XETK_REF 1
                /end ETK_XETK_SPECIFIC
            /end QP_BLOB
        /end SOURCE

        /begin SOURCE
            "task_100ms"
            0
            100000
            /begin QP_BLOB
                2
                2
                100000
                /begin ETK_XETK_SPECIFIC
                    TRG_NBR 16
                    INDIRECT 0x40003b78
                    /begin DISTAB_LAYOUT
                        0x40003b80
                        0x0
                        0x0
                        0x0
                    /end DISTAB_LAYOUT
                    ETK_XETK_REF 1
                /end ETK_XETK_SPECIFIC
            /end QP_BLOB
        /end SOURCE

        /begin SOURCE
            "task_1000ms"
            0
            1000000
            /begin QP_BLOB
                1
                1
                1000000
                /begin ETK_XETK_SPECIFIC
                    TRG_NBR 15
                    INDIRECT 0x40003b68
                    /begin DISTAB_LAYOUT
                        0x40003b70
                        0x0
                        0x0
                        0x0
                    /end DISTAB_LAYOUT
                    ETK_XETK_REF 1
                /end ETK_XETK_SPECIFIC
            /end QP_BLOB
        /end SOURCE

      /end IF_DATA

      /begin IF_DATA ASAP1B_CCP

        /begin SOURCE
          "10_ms"
          3    /* 1 ms (CSE)        */
          10    /* Rate in Scaling Unit: 10*1 ms */
          /begin QP_BLOB
            0
            LENGTH       30
            CAN_ID_FIXED 1784
            RASTER       2
            FIRST_PID    0
          /end QP_BLOB

        /end SOURCE

        /begin SOURCE
          "100_ms"
          3    /* 1 ms (CSE)        */
          100    /* Rate in Scaling Unit: 100*1 ms */
          /begin QP_BLOB
            1
            LENGTH       30
            CAN_ID_FIXED 1784
            RASTER       5
            FIRST_PID    30
          /end QP_BLOB

        /end SOURCE

        /begin SOURCE
          "200_ms"
          3    /* 1 ms (CSE)        */
          200    /* Rate in Scaling Unit: 200*1 ms */
          /begin QP_BLOB
            2
            LENGTH       30
            CAN_ID_FIXED 1784
            RASTER       6
            FIRST_PID    60
          /end QP_BLOB

        /end SOURCE

        /begin SOURCE
          "1000_ms"
          3    /* 1 ms (CSE)        */
          1000    /* Rate in Scaling Unit: 1000*1 ms */
          /begin QP_BLOB
            3
            LENGTH       30
            CAN_ID_FIXED 1784
            RASTER       8
            FIRST_PID    90
          /end QP_BLOB

        /end SOURCE

        /begin RASTER
          "Time synchronous event channel - 10 ms"
          "10_ms"
          2   /* Raster 2 (Reference from signal SOURCE)*/
          3   /* 1 ms (CSE) */
          10   /* Rate in Scaling Unit: 10*1 ms */
        /end RASTER

        /begin RASTER
          "Time synchronous event channel - 100 ms"
          "100_ms"
          5   /* Raster 5 (Reference from signal SOURCE)*/
          3   /* 1 ms (CSE) */
          100   /* Rate in Scaling Unit: 100*1 ms */
        /end RASTER

        /begin RASTER
          "Time synchronous event channel - 200 ms"
          "200_ms"
          6   /* Raster 6 (Reference from signal SOURCE)*/
          3   /* 1 ms (CSE) */
          200   /* Rate in Scaling Unit: 200*1 ms */
        /end RASTER

        /begin RASTER
          "Time synchronous event channel - 1000 ms"
          "1000_ms"
          8   /* Raster 8 (Reference from signal SOURCE)*/
          3   /* 1 ms (CSE) */
          1000   /* Rate in Scaling Unit: 1000*1 ms */
        /end RASTER

        /begin TP_BLOB
          /* CCP version       */ 0x201
          /* Blob version      */ 0x202
          /* CAN msg ID - send */ 1785
          /* CAN msg ID - recv */ 1784
          /* station address   */ 0
          /* byte order        */ 1

          /begin CAN_PARAM
            /* crystal frequency */ 0x1F4
            /* timing register 0 */ 0x41
            /* timing register 1 */ 0x25
          /end CAN_PARAM

          /* Global measurement mode settings */
          DAQ_MODE          BURST
          CONSISTENCY       ODT
          ADDRESS_EXTENSION ODT

          /begin CHECKSUM_PARAM
            /* algorithm */ 0x8006
            /* limit     */ 0xFFFFFFFF
            CHECKSUM_CALCULATION ACTIVE_PAGE
          /end CHECKSUM_PARAM

          /begin DEFINED_PAGES
            1
            "working page"
            /* address ext. */ 0x0
            /* base address */ 0x80000
            /* page length  */ 0x12ab4
            RAM
            RAM_INIT_BY_ECU
          /end DEFINED_PAGES

          OPTIONAL_CMD 0x08 /* START_STOP_ALL */
          OPTIONAL_CMD 0x0C /* SET_S_STATUS */
          OPTIONAL_CMD 0x0D /* GET_S_STATUS */
          OPTIONAL_CMD 0x0E /* BUILD_CHKSUM */
          OPTIONAL_CMD 0x0F /* SHORT_UP */
          OPTIONAL_CMD 0x10 /* CLEAR_MEMORY */
          OPTIONAL_CMD 0x18 /* PROGRAM */
          OPTIONAL_CMD 0x23 /* DNLOAD_6 */
          OPTIONAL_CMD 0x22 /* PROGRAM_6 */

        /end TP_BLOB

      /end IF_DATA

      /* Scalar measurable for DDE 'ADM_NU_Alpha'. */
